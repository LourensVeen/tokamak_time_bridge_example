ymmsl_version: v0.2

description: |
  This runs the plasma model, diagnostics, control, and the time bridges between them

imports:
  - from ttb_example.reactor import implementation reactor
  - from ttb_example.programs.plasma import implementation plasma
  - from ttb_example.programs.bridge_plasma_diagnostics import implementation bridge_plasma_diagnostics
  - from ttb_example.programs.diagnostics import implementation diagnostics
  - from ttb_example.programs.bridge_diagnostics_control import implementation bridge_diagnostics_control
  - from ttb_example.programs.control import implementation control
  - from ttb_example.programs.bridge_control_plasma import implementation bridge_control_plasma

custom_implementations:
  reactor.plasma: plasma
  reactor.bridge_plasma_diagnostics: bridge_plasma_diagnostics
  reactor.diagnostics: diagnostics
  reactor.bridge_diagnostics_control: bridge_diagnostics_control
  reactor.control: control
  reactor.bridge_control_plasma: bridge_control_plasma

settings:
  muscle_remote_log_level: DEBUG
  muscle_local_log_level: DEBUG

